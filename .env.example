# ==============================================================================
# Explainable Employee Burnout Detection using ML, Sentiment Analysis and RAG
# ------------------------------------------------------------------------------
# Person 3 (RAG Backend) + Person 4 (Frontend Dashboard) configuration.
#
# USAGE
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Then edit .env. NEVER commit .env — it is git-ignored.
#
# PROVIDER SWITCHING
#   Changing LLM_PROVIDER below is the ONLY change required to switch between
#   OpenAI, Gemini and Llama/Ollama. No Python file needs to be edited.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. LLM PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Accepted values (case-insensitive):
#   ollama   -> local Llama / Mistral / Phi via Ollama. Free, offline, no API key.
#   openai   -> OpenAI or any OpenAI-compatible endpoint (Groq, Together, vLLM...)
#   gemini   -> Google Gemini
#
# Default is `ollama` so the project runs end-to-end with no API key and no cost.
LLM_PROVIDER=ollama


# ------------------------------------------------------------------------------
# 2. OLLAMA  (used when LLM_PROVIDER=ollama)
# ------------------------------------------------------------------------------
# Install Ollama from https://ollama.com/download then run:
#   ollama pull llama3.1
#   ollama serve
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434


# ------------------------------------------------------------------------------
# 3. OPENAI  (used when LLM_PROVIDER=openai)
# ------------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# OPENAI_BASE_URL lets you point the SAME code at any OpenAI-compatible server
# without touching llm_client.py. Leave blank for real OpenAI. Examples:
#   Groq       -> https://api.groq.com/openai/v1
#   Together   -> https://api.together.xyz/v1
#   local vLLM -> http://localhost:8000/v1
OPENAI_BASE_URL=


# ------------------------------------------------------------------------------
# 4. GEMINI  (used when LLM_PROVIDER=gemini)
# ------------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash


# ------------------------------------------------------------------------------
# 5. SHARED LLM GENERATION SETTINGS
# ------------------------------------------------------------------------------
# Low temperature: this is an analytical/clinical task, we want reproducible,
# grounded output rather than creative writing.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Seconds to wait for the LLM before giving up. Local Ollama on CPU is slow,
# so this is deliberately generous.
LLM_TIMEOUT=120


# ------------------------------------------------------------------------------
# 6. DATA SOURCE  (Person 2's output — consumed read-only, never regenerated)
# ------------------------------------------------------------------------------
# Path is relative to the REPOSITORY ROOT. Person 3 and Person 4 both read this
# single file. The ML pipeline is NOT re-run by the backend.
BURNOUT_CSV_PATH=outputs/burnout_scores.csv

# Prefix for the synthetic, stable employee identifiers generated by
# backend/data_loader.py. Person 2's CSV has no employee_id column, so IDs are
# derived deterministically from row order (EMP_0001, EMP_0002, ...).
# If Person 2 later adds a real `employee_id` column, it is detected and used
# automatically and this prefix is ignored.
EMPLOYEE_ID_PREFIX=EMP

# Maximum value of Person 2's integer burnout_score scale, used ONLY to convert
# the raw point score into a 0-100 percentage for display.
# Derived from models/burnout/burnout_score.py, whose worst realistic case is
# roughly: sentiment(+2) + anger + fear + sadness + 4 behavioural flags.
BURNOUT_SCORE_MAX=12


# ------------------------------------------------------------------------------
# 7. EMBEDDINGS  (Sentence Transformers)
# ------------------------------------------------------------------------------
# all-MiniLM-L6-v2: 384 dimensions, ~80MB, fast on CPU. Downloaded once from
# HuggingFace on first run and cached in ~/.cache/huggingface.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# cpu | cuda | mps    (mps = Apple Silicon GPU)
EMBEDDING_DEVICE=cpu

# Rows encoded per batch. Lower this if you hit memory limits on a large CSV.
EMBEDDING_BATCH_SIZE=32


# ------------------------------------------------------------------------------
# 8. CHROMADB VECTOR STORE
# ------------------------------------------------------------------------------
# Persisted on local disk so the index survives backend restarts and does not
# need rebuilding on every launch. Git-ignored.
CHROMA_PERSIST_DIR=backend/chroma_db
CHROMA_COLLECTION=burnout_records


# ------------------------------------------------------------------------------
# 9. RETRIEVAL
# ------------------------------------------------------------------------------
# Number of employee records fed to the LLM as context per question.
RETRIEVER_TOP_K=5

# Hard ceiling on top_k accepted from an API request, to stop a caller
# overflowing the LLM context window.
RETRIEVER_MAX_K=25


# ------------------------------------------------------------------------------
# 10. FASTAPI BACKEND
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated origins allowed to call the API. `*` is fine for local
# development; restrict this before any real deployment.
CORS_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 11. STREAMLIT FRONTEND (Person 4)
# ------------------------------------------------------------------------------
# Where the dashboard sends its API calls. Must match BACKEND_HOST/PORT above.
API_BASE_URL=http://localhost:8000

# Seconds the dashboard waits for a backend response. Must be >= LLM_TIMEOUT,
# otherwise the dashboard times out while the LLM is still generating.
API_TIMEOUT=180

FRONTEND_PORT=8501
